[Unit]
Description=NumLock Auto-Locker Daemon for KDE Plasma 6
Documentation=https://github.com/jeremias/numlock_toggle
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/Apps/numlock_toggle/scripts/numlock_helper.py --daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
